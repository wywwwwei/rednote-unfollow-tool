{
  "manifest_version": 3,
  "name": "Rednote 关注管理与多选取关助手",
  "version": "1.0.0",
  "description": "小红书 / Rednote 网页端关注列表管理：互关置顶、单向倒序、一键勾选单向关注、安全限流批量取关与记录备份导出。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.rednote.com/*",
    "https://www.xiaohongshu.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.rednote.com/*",
        "https://www.xiaohongshu.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ]
}
