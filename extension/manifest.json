{
  "manifest_version": 3,
  "name": "Rednote 批量取关助手",
  "version": "1.0.0",
  "description": "小红书 / Rednote 网页端高效批量取关工具：一键勾选单向关注、智能排除互关好友、安全限流防风控、支持数据备份导出。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.rednote.com/*",
    "https://www.xiaohongshu.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.rednote.com/*",
        "https://www.xiaohongshu.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ]
}
